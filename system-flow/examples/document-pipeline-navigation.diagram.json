{
  "schemaVersion": "2.0",
  "id": "document-pipeline-navigation",
  "title": "文档处理 · 分层探索",
  "description": "教学假设：总览、解析组件、切分细节与索引组件均为阅读视图，非真实业务执行或部署。",
  "view": {
    "kind": "overview",
    "direction": "RIGHT",
    "theme": "light"
  },
  "groups": [
    {
      "id": "processing-domain",
      "label": "内容处理"
    },
    {
      "id": "retrieval-domain",
      "label": "检索与存储"
    }
  ],
  "nodes": [
    {
      "id": "document-input",
      "kind": "start",
      "label": "文档输入",
      "details": "提供待处理文档的逻辑入口，不指定文件类型或上传接口。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "text-parser",
      "kind": "process",
      "label": "文本解析器",
      "details": "读取并整理文本，按显式教学步骤交付可索引片段。",
      "evidenceStatus": "assumed",
      "groupId": "processing-domain"
    },
    {
      "id": "vector-indexer",
      "kind": "process",
      "label": "向量索引器",
      "details": "把文本片段转为逻辑表示并写入存储；模型与重试策略未指定。",
      "evidenceStatus": "assumed",
      "groupId": "processing-domain"
    },
    {
      "id": "vector-store",
      "kind": "store",
      "label": "索引存储",
      "details": "承载逻辑向量索引，不指定数据库产品或持久化协议。",
      "evidenceStatus": "assumed",
      "groupId": "retrieval-domain"
    },
    {
      "id": "search-api",
      "kind": "external",
      "label": "检索入口",
      "details": "使用已建立的索引，检索策略和接口尚未指定。",
      "evidenceStatus": "assumed",
      "groupId": "retrieval-domain"
    }
  ],
  "edges": [
    {
      "id": "input-to-parser",
      "source": "document-input",
      "target": "text-parser",
      "kind": "control",
      "directed": true,
      "label": "交付文档",
      "evidenceStatus": "assumed"
    },
    {
      "id": "parser-to-indexer",
      "source": "text-parser",
      "target": "vector-indexer",
      "kind": "data",
      "directed": true,
      "label": "文本片段",
      "evidenceStatus": "assumed"
    },
    {
      "id": "indexer-to-store",
      "source": "vector-indexer",
      "target": "vector-store",
      "kind": "data",
      "directed": true,
      "label": "保存索引",
      "evidenceStatus": "assumed"
    },
    {
      "id": "search-to-store",
      "source": "search-api",
      "target": "vector-store",
      "kind": "dependency",
      "directed": true,
      "label": "读取索引",
      "evidenceStatus": "assumed"
    }
  ],
