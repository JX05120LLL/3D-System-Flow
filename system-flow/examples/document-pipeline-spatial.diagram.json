{
  "schemaVersion": "2.0",
  "id": "document-pipeline-spatial",
  "title": "文档处理流水线 · 三维组件与建索引演示",
  "description": "教学假设：由文档输入、解析、向量索引和检索组成。内部ID没有路径前缀，归属只由owner声明。本图不读取用户文档、不调用模型、不写入数据库；模型尺寸与演示时长不表示真实业务性能。",
  "view": {
    "kind": "overview",
    "direction": "RIGHT",
    "theme": "light"
  },
  "groups": [
    {
      "id": "processing-domain",
      "label": "内容处理"
    },
    {
      "id": "retrieval-domain",
      "label": "检索与存储"
    }
  ],
  "nodes": [
    {
      "id": "document-input",
      "kind": "start",
      "label": "文档输入",
      "details": "提供待处理文档的逻辑入口，不指定文件类型或上传接口。",
      "evidenceStatus": "assumed"
    },
    {
      "id": "text-parser",
      "kind": "process",
      "label": "文本解析器",
      "details": "读取并整理文本，按显式教学步骤交付可索引片段。",
      "evidenceStatus": "assumed",
      "groupId": "processing-domain"
    },
    {
      "id": "vector-indexer",
      "kind": "process",
      "label": "向量索引器",
      "details": "把文本片段转为逻辑表示并写入存储；模型与重试策略未指定。",
      "evidenceStatus": "assumed",
      "groupId": "processing-domain"
    },
    {
      "id": "vector-store",
      "kind": "store",
      "label": "索引存储",
      "details": "承载逻辑向量索引，不指定数据库产品或持久化协议。",
      "evidenceStatus": "assumed",
      "groupId": "retrieval-domain"
    },
    {
      "id": "search-api",
      "kind": "external",
      "label": "检索入口",
      "details": "使用已建立的索引，检索策略和接口尚未指定。",
      "evidenceStatus": "assumed",
      "groupId": "retrieval-domain"
    }
  ],
  "edges": [
    {
      "id": "input-to-parser",
      "source": "document-input",
      "target": "text-parser",
      "kind": "control",
      "directed": true,
      "label": "交付文档",
      "evidenceStatus": "assumed"
    },
    {
      "id": "parser-to-indexer",
      "source": "text-parser",
      "target": "vector-indexer",
      "kind": "data",
      "directed": true,
      "label": "文本片段",
      "evidenceStatus": "assumed"
    },
    {
      "id": "indexer-to-store",
      "source": "vector-indexer",
      "target": "vector-store",
      "kind": "data",
      "directed": true,
      "label": "保存索引",
      "evidenceStatus": "assumed"
    },
    {
      "id": "search-to-store",
      "source": "search-api",
      "target": "vector-store",
      "kind": "dependency",
      "directed": true,
      "label": "读取索引",
      "evidenceStatus": "assumed"
    }
  ],
  "spatial": {
    "interiors": [
      {
        "owner": "text-parser",
        "nodes": [
          {
            "id": "read-document",
            "kind": "start",
            "label": "读取文档",
            "details": "获取本次教学输入的文本。",
            "evidenceStatus": "assumed"
          },
          {
            "id": "normalize-text",
            "kind": "process",
            "label": "整理文本",
            "details": "代表文本整理职责，不指定清洗规则。",
            "evidenceStatus": "assumed"
          },
          {
            "id": "split-chunks",
            "kind": "end",
            "label": "生成片段",
            "details": "把文本拆为可索引片段，不指定长度或重叠策略。",
            "evidenceStatus": "assumed"
          }
        ],
        "edges": [
          {
            "id": "read-to-normalize",
            "source": "read-document",
            "target": "normalize-text",
            "kind": "control",
            "directed": true,
            "label": "文本内容",
            "evidenceStatus": "assumed"
          },
          {
            "id": "normalize-to-split",
            "source": "normalize-text",
            "target": "split-chunks",
            "kind": "control",
            "directed": true,
            "label": "整理结果",
            "evidenceStatus": "assumed"
          }
        ]
      },
      {
        "owner": "vector-indexer",
        "nodes": [
          {
            "id": "encode-chunks",
            "kind": "start",
            "label": "生成表示",
            "details": "代表逻辑向量化职责，不调用真实模型。",
            "evidenceStatus": "assumed"
          },
          {
            "id": "persist-index",
            "kind": "end",
            "label": "写入索引",
            "details": "关联外层索引存储，不指定事务或幂等策略。",
            "evidenceStatus": "assumed"
          }
        ],
        "edges": [
          {
            "id": "encode-to-persist",
            "source": "encode-chunks",
            "target": "persist-index",
            "kind": "data",
            "directed": true,
            "label": "片段与表示",
            "evidenceStatus": "assumed"
          }
        ]
      }
    ],
    "models": [
      {
        "nodeId": "document-input",
        "shape": "client",
        "color": "#69e1dd",
        "shortLabel": "文档输入"
      },
      {
        "nodeId": "text-parser",
        "shape": "shell",
        "color": "#559eff",
        "shortLabel": "文本解析"
      },
      {
        "nodeId": "vector-indexer",
        "shape": "shell",
        "color": "#ac91ff",
        "shortLabel": "向量索引"
      },
      {
        "nodeId": "vector-store",
        "shape": "database",
        "color": "#4de1b3",
        "shortLabel": "索引存储"
      },
      {
        "nodeId": "search-api",
        "shape": "external",
        "color": "#edbf78",
        "shortLabel": "检索入口"
      },
      {
        "nodeId": "read-document",
        "shape": "gateway"
      },
      {
        "nodeId": "normalize-text",
        "shape": "adjust"
      },
      {
        "nodeId": "split-chunks",
        "shape": "result"
      },
      {
        "nodeId": "encode-chunks",
        "shape": "channel"
      },
      {
        "nodeId": "persist-index",
        "shape": "ledger"
      }
    ],
    "scenarios": [
      {
        "id": "build-index",
        "label": "文档建索引",
        "steps": [
          {
            "id": "accept-document",
            "title": "接入文档",
            "description": "教学示意：输入进入解析器的读取职责。",
            "route": [
              "document-input",
              "text-parser",
              "read-document"
            ],
            "focusId": "read-document",
            "tone": "request",
            "durationMs": 2200
          },
          {
            "id": "prepare-chunks",
            "title": "整理并切分",
            "description": "教学示意：读取文本交给整理和片段生成职责。",
            "route": [
              "read-document",
              "normalize-text",
              "split-chunks"
            ],
            "focusId": "split-chunks",
            "tone": "data",
            "durationMs": 2200
          },
          {
            "id": "encode-document",
            "title": "生成片段表示",
            "description": "教学示意：片段进入索引器的表示生成职责。",
            "route": [
              "split-chunks",
              "vector-indexer",
              "encode-chunks"
            ],
            "focusId": "encode-chunks",
            "tone": "request",
            "durationMs": 2800
          },
          {
            "id": "save-index",
            "title": "保存逻辑索引",
            "description": "教学示意：表示生成后经写入职责关联外层存储。",
            "route": [
              "encode-chunks",
              "persist-index",
              "vector-store"
            ],
            "focusId": "persist-index",
            "tone": "data",
            "durationMs": 2200
          },
          {
            "id": "ready-for-search",
            "title": "准备检索",
            "description": "教学示意：已建立的索引可由检索入口关联。本步骤不执行真实查询。",
            "route": [
              "vector-store",
              "search-api"
            ],
            "focusId": "search-api",
            "tone": "success",
            "durationMs": 2200
          }
        ]
      }
    ]
  }
}
